rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role Verification from Firestore (Requirement 1)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isSeeker() {
      return isAuthenticated() && getUserRole() == 'seeker';
    }

    // 1. Private Users Collection (Requirements 1 & 3)
    // - Contains sensitive private data: email, phone, role, uid, etc.
    // - STRICT OWNER-ONLY READ: No user can read another user's private document.
    // - Protects personal customer, manager, and seeker privacy.
    // - ROLE IMMUTABILITY: Users cannot change their assigned role or UID after registration.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.role in ['customer', 'manager', 'seeker'] &&
                       request.resource.data.uid == userId;
      allow update: if isOwner(userId) &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // 2. Public Profiles Collection (Requirement 3)
    // - Public directory discoverability for Event Managers and Job Seekers.
    // - SENSITIVE DATA FORBIDDEN: 'email', 'phone', 'phoneNumber', 'password' are strictly prohibited.
    // - Customer profiles are strictly excluded from public directory.
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) &&
                               request.resource.data.role in ['manager', 'seeker'] &&
                               request.resource.data.uid == userId &&
                               !('email' in request.resource.data) &&
                               !('phone' in request.resource.data) &&
                               !('phoneNumber' in request.resource.data) &&
                               !('password' in request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 3. Event Requests Collection (Requirements 1 & 2)
    // - Creation: ONLY verified Customer in Firestore (isCustomer()) with status 'open'.
    // - Read: STRICT RESTRICTION (Requirement 2):
    //     a) The owner customer (resource.data.customerId == request.auth.uid)
    //     b) OR verified Event Managers (isManager()) reviewing open requests.
    //     Seekers and unauthorized users CANNOT read event requests.
    // - Updates:
    //     a) Verified Customer can edit event specifications ONLY.
    //     b) Verified Customer can cancel request (status -> 'cancelled').
    //     c) Verified Customer can mark booked (status -> 'booked').
    //     d) Verified Manager submitting proposal can only update status from 'open' to 'proposals_received'.
    //     e) Customer cannot arbitrarily alter status.
    match /requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        (isManager() && resource.data.status in ['open', 'proposals_received'])
      );
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.status == 'open';
      allow update: if isAuthenticated() && (
        // Case A: Customer edits permitted event details (customerId immutable, status unchanged)
        (isCustomer() &&
         resource.data.customerId == request.auth.uid &&
         resource.data.status in ['open', 'proposals_received'] &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'eventName', 'eventType', 'eventDate', 'location', 'budget', 'guestCount', 'requiredServices'
         ])
        ) ||
        // Case B: Customer cancels their request (status only)
        (isCustomer() &&
         resource.data.customerId == request.auth.uid &&
         resource.data.status in ['open', 'proposals_received'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled'
        ) ||
        // Case C: Customer marks request booked upon proposal acceptance (status only)
        (isCustomer() &&
         resource.data.customerId == request.auth.uid &&
         resource.data.status == 'proposals_received' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'booked'
        ) ||
        // Case D: Manager marks request proposals_received (status only)
        (isManager() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         resource.data.status == 'open' &&
         request.resource.data.status == 'proposals_received')
      );
      allow delete: if isCustomer() && resource.data.customerId == request.auth.uid;
    }

    // 4. Proposals Collection (Requirement 1)
    // - Creation: ONLY verified Event Managers in Firestore (isManager()). Must reference existing request.
    // - Read: ONLY author manager or target customer who owns the event request.
    // - Updates:
    //     a) Manager can only update permitted quote fields while pending (managerId, requestId immutable).
    //     b) Target customer (isCustomer()) can only accept or reject proposal (status only).
    // - Delete: Author manager while pending.
    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (
        resource.data.managerId == request.auth.uid ||
        get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid
      );
      allow create: if isManager() &&
                       request.resource.data.managerId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId));
      allow update: if isAuthenticated() && (
        // Manager updates permitted fields
        (isManager() &&
         resource.data.managerId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.managerId == resource.data.managerId &&
         request.resource.data.requestId == resource.data.requestId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'proposedPrice', 'servicesIncluded', 'additionalDetails'
         ])
        ) ||
        // Target customer accepts or rejects
        (isCustomer() &&
         get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status in ['accepted', 'rejected'])
      );
      allow delete: if isManager() && resource.data.managerId == request.auth.uid && resource.data.status == 'pending';
    }

    // 5. Confirmed Bookings Collection (Requirements 1, 4, 5, 6)
    // - Anti-Forgery Creation: ONLY verified Customer in Firestore (isCustomer()).
    //   Must reference an existing accepted proposal, matching price and participants.
    // - Read: STRICT TWO-PARTY ISOLATION (Only involved customer and manager).
    // - Update Restrictions:
    //     a) Customers CANNOT change booking progress or payment amounts directly (Requirement 4).
    //     b) Managers CANNOT change payment fields (Requirement 5).
    //        Manager can only update execution fields ('progress', 'progressPercent', 'status').
    //        'paidAmount', 'remainingAmount', and 'totalAmount' are strictly immutable by manager.
    //     c) Do NOT mark payments as completed or change paid balances without trusted gateway (Requirement 6).
    //        Clients cannot directly set status: 'completed' or mutate financial ledger balances.
    // - Delete: STRICTLY FORBIDDEN.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
                     (resource.data.customerId == request.auth.uid || resource.data.managerId == request.auth.uid);
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.status == 'confirmed' &&
                       exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)) &&
                       get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.status == 'accepted' &&
                       get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.requestId == request.resource.data.requestId &&
                       get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.managerId == request.resource.data.managerId &&
                       get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.customerId == request.auth.uid &&
                       request.resource.data.totalAmount == get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.proposedPrice;
      allow update: if isAuthenticated() && (
        // Manager execution updates ONLY.
        // Payment fields (paidAmount, remainingAmount, totalAmount) CANNOT be changed by manager (Requirement 5).
        // Status cannot be marked 'completed' directly from client (Requirement 6).
        (isManager() &&
         resource.data.managerId == request.auth.uid &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.managerId == resource.data.managerId &&
         request.resource.data.totalAmount == resource.data.totalAmount &&
         request.resource.data.requestId == resource.data.requestId &&
         request.resource.data.proposalId == resource.data.proposalId &&
         request.resource.data.paidAmount == resource.data.paidAmount &&
         request.resource.data.remainingAmount == resource.data.remainingAmount &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'progress', 'progressPercent', 'status'
         ]) &&
         request.resource.data.status in ['confirmed', 'ongoing']
        )
      );
      allow delete: if false;
    }

    // 6. Job Listings Collection (Requirement 1)
    // - Creation: ONLY verified Event Managers in Firestore (isManager()).
    // - Read: Any authenticated user.
    // - Update / Delete: ONLY the author manager (isManager()).
    match /jobListings/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isManager() &&
                       request.resource.data.managerId == request.auth.uid &&
                       request.resource.data.status == 'open';
      allow update: if isManager() &&
                       resource.data.managerId == request.auth.uid &&
                       request.resource.data.managerId == resource.data.managerId;
      allow delete: if isManager() && resource.data.managerId == request.auth.uid;
    }

    // 7. Job Applications Collection (Requirement 1)
    // - Creation: ONLY verified Job Seekers in Firestore (isSeeker()).
    //   Must reference an existing job listing and matching managerId.
    // - Read: STRICT TWO-PARTY ISOLATION (Only applicant and hiring manager).
    // - Update: ONLY the hiring manager (isManager()).
    //   Applicant CANNOT self-approve.
    //   Ownership fields cannot change.
    // - Delete: Applicant can withdraw while under review.
    match /applications/{appId} {
      allow read: if isAuthenticated() &&
                     (resource.data.applicantId == request.auth.uid || resource.data.managerId == request.auth.uid);
      allow create: if isSeeker() &&
                       request.resource.data.applicantId == request.auth.uid &&
                       request.resource.data.status in ['applied', 'under_review'] &&
                       exists(/databases/$(database)/documents/jobListings/$(request.resource.data.jobId)) &&
                       request.resource.data.managerId == get(/databases/$(database)/documents/jobListings/$(request.resource.data.jobId)).data.managerId;
      allow update: if isManager() &&
                       resource.data.managerId == request.auth.uid &&
                       request.resource.data.applicantId == resource.data.applicantId &&
                       request.resource.data.managerId == resource.data.managerId &&
                       request.resource.data.jobId == resource.data.jobId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       request.resource.data.status in ['under_review', 'accepted', 'rejected', 'selected'];
      allow delete: if isSeeker() &&
                       resource.data.applicantId == request.auth.uid &&
                       resource.data.status in ['applied', 'under_review'];
    }

    // 8. Payment Transactions Collection (Requirements 1 & 6)
    // - Creation: ONLY verified Customer in Firestore (isCustomer()).
    // - Client-created records MUST be explicit sandbox simulation records:
    //     `isSimulation == true` and `status == 'simulation_settled'`.
    // - CLIENT CANNOT CREATE REAL 'completed' PAYMENTS (Requirement 6).
    // - Read: STRICT TWO-PARTY (Only customer and manager).
    // - Update / Delete: STRICTLY FORBIDDEN.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
                     (resource.data.customerId == request.auth.uid || resource.data.managerId == request.auth.uid);
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.isSimulation == true &&
                       request.resource.data.status == 'simulation_settled';
      allow update: if false;
      allow delete: if false;
    }

    // 9. Seeker Earnings Collection (Requirements 1 & 7)
    // - Creation: ONLY verified Event Managers in Firestore (isManager()).
    // - RELATIONALLY VERIFIED APPLICATION (Requirement 7):
    //     Earnings can ONLY be created for genuinely accepted/selected job applications!
    //     Must link to an existing application where:
    //       application.managerId == request.auth.uid
    //       application.applicantId == request.resource.data.seekerId
    //       application.jobId == request.resource.data.jobId
    //       application.status in ['accepted', 'selected']
    //   Cannot be created for unaccepted applications or merely any job listing!
    // - Read: STRICT OWNER-ONLY (Only the earning job seeker).
    // - Update / Delete: STRICTLY FORBIDDEN.
    match /earnings/{earningId} {
      allow read: if isAuthenticated() && resource.data.seekerId == request.auth.uid;
      allow create: if isManager() &&
                       request.resource.data.managerId == request.auth.uid &&
                       request.resource.data.seekerId != request.auth.uid &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.status == 'pending' &&
                       exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)) &&
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.managerId == request.auth.uid &&
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicantId == request.resource.data.seekerId &&
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.jobId == request.resource.data.jobId &&
                       get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.status in ['accepted', 'selected'];
      allow update: if false;
      allow delete: if false;
    }
  }
}
